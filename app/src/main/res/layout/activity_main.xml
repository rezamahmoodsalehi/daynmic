<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Device -->
        <TextView style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/section_device" />
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/tvDevice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions -->
        <TextView style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/section_perms" />
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                    <TextView android:id="@+id/tvOverlay" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/perm_overlay" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlay"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/grant" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                    <TextView android:id="@+id/tvAccess" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/perm_access" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccess"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/grant" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                    <TextView android:id="@+id/tvPost" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/perm_post" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPost"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/grant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnable"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/enable_island"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- Style -->
        <TextView style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/section_style" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleAuto"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/style_auto" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyleDark"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/style_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Camera position test -->
        <TextView style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/section_cam" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleCam"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamAuto" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:insetLeft="0dp" android:insetRight="0dp"
                android:paddingHorizontal="2dp" android:text="@string/cam_auto" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamLeft" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingHorizontal="2dp" android:text="@string/cam_btn_left" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamCenter" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingHorizontal="2dp" android:text="@string/cam_btn_center" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamRight" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingHorizontal="2dp" android:text="@string/cam_btn_right" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamNone" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingHorizontal="2dp" android:text="@string/cam_btn_none" android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Tests -->
        <TextView style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/section_test" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/test_message" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestMusic"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/test_music" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestLock"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/test_lock" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickAudio"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/pick_audio" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestOngoing"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/test_ongoing" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopAll"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="@string/stop_all" />
    </LinearLayout>
</ScrollView>
